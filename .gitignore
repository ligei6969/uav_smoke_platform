# Ignore every root-level file and directory by default.
/*

# Keep this file tracked.
!/.gitignore

# Track only the UAV smoke platform workspace and everything under it.
!/uav_smoke_platform/
!/uav_smoke_platform/**

# Keep generated build files out of Git.
/uav_smoke_platform/build/
uav_smoke_platform/data/videos/
/uav_smoke_platform/models/

# Independent, hardware-free C++ event gateway.
!/smoke_gateway/
!/smoke_gateway/**
/smoke_gateway/build*/
/smoke_gateway/results/
/smoke_gateway/*.journal
/smoke_gateway/**/__pycache__/

# Modular M350/H30T/Nano mainline. task/.gitignore excludes local assets/builds.
!/task/
!/task/**
