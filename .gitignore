# Ignore every root-level file and directory by default.
/*

# Keep this file tracked.
!/.gitignore

# Track only the UAV smoke platform workspace and everything under it.
!/uav_smoke_platform/
!/uav_smoke_platform/**

# Keep generated build files out of Git.
/uav_smoke_platform/build/

# Keep local video inputs out of Git.
/uav_smoke_platform/data/videos/

# Keep model weights and generated analysis output out of Git.
/uav_smoke_platform/models/
/uav_smoke_platform/results/
/uav_smoke_platform/storage/
*.pt
*.onnx
*.mp4
*.avi
*.mov

# Keep Python interpreter caches out of Git.
__pycache__/
*.py[cod]
